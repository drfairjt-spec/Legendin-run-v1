# NODE_ENV: runtime environment (development | production)
NODE_ENV=development

# PORT: HTTP server port (default: 3000)
PORT=3000

# JWT_SECRET: secret used to sign/verify JWT tokens (required in production).
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-32-or-more-characters-long

# DB_PATH: path to the SQLite database file
DB_PATH=./data/legendin.db

# UPLOAD_ROOT: directory where uploaded files are stored
UPLOAD_ROOT=./uploads

# GEMINI_API_KEY: required for the AI chat assistant (/api/chat)
GEMINI_API_KEY=your-gemini-api-key

# SEED_PASSWORD: password used by `npm run db:seed` (dev only)
SEED_PASSWORD=change-me